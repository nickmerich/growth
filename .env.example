# iGRYT Event Timer — Supabase configuration
#
# Copy this file to `.env.local` and fill in your project values to run the app
# against a real Supabase project. If these are left blank, the app falls back to
# a browser localStorage backend so it still builds and runs for local demos.
#
# Find these in the Supabase dashboard under Project Settings → API.
#
# In Supabase mode, organizers must sign in (RLS keys writes on owner identity).
# Enable Email auth under Authentication → Providers; disabling "Confirm email"
# gives the quickest local loop. See the README "Supabase mode" section.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
